# Copy this file to .env for local development, or set these as environment
# variables in the hosting provider (Neon is the strategic PostgreSQL target
# per ADR-019). Never commit the real .env file.

# From your Upstox developer app (https://account.upstox.com/developer/apps)
UPSTOX_API_KEY=your-upstox-api-key
UPSTOX_API_SECRET=your-upstox-api-secret

# Must exactly match the redirect URI registered on your Upstox app,
# e.g. https://<your-backend-host>/auth/callback
UPSTOX_REDIRECT_URI=http://localhost:8000/auth/callback

# Where the Next.js frontend is served from (used for redirects and CORS),
# e.g. https://<your-frontend>.vercel.app
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (ADR-017 / ADR-018 / ADR-019)
# ---------------------------------------------------------------------------
# PostgreSQL is the strategic production target (Neon managed, per ADR-019).
# CockroachDB is retired and is not a supported target. SQLite remains the
# local default: when DATABASE_URL is unset or a sqlite:// URL, the migration
# settings below are ignored and startup stays single-process.
#
# Runtime application connection string. Never a migration identity.
# DATABASE_URL=postgresql+psycopg://<runtime-user>:<password>@<host>/<database>?sslmode=require

# REQUIRED whenever DATABASE_URL is PostgreSQL. A DISTINCT migration identity
# is mandatory: a missing value never means "reuse DATABASE_URL", and an
# identity equal to the runtime identity is refused. The runtime identity must
# have zero access to the migration_internal schema and to the lease objects.
# STRIKENOVA_MIGRATION_DATABASE_URL=postgresql+psycopg://<migrator-user>:<password>@<host>/<database>?sslmode=require

# Optional: comma-separated host equivalence pairs (hostA=hostB) for the rare
# case where one logical database is reachable through two hostnames, such as
# a Neon pooled route and its direct route. Empty means a different host is a
# different database.
# STRIKENOVA_MIGRATION_TARGET_ALIASES=

# Provider-neutral environment selector. STRIKENOVA_ENV=production is the
# primary production signal regardless of host.
# STRIKENOVA_ENV=development

# Migration lease (ADR-017). Defaults are shown; override only with measured
# evidence. The statement timeout must stay STRICTLY BELOW the lease TTL so a
# runaway backfill transaction fails before ownership can expire.
# MIGRATION_LEASE_TTL_SECONDS=300
# MIGRATION_LEASE_WAIT_SECONDS=180
# MIGRATION_LEASE_LOCK_TIMEOUT_MS=10000
# MIGRATION_BACKFILL_STATEMENT_TIMEOUT_MS=150000

# Identity names (ADR-018). The defaults below are PRODUCTION role names;
# staging and preview environments must set their actual role names explicitly
# rather than relying on these.
# STRIKENOVA_MIGRATOR_ROLE=strikenova_prod_migrator
# STRIKENOVA_RUNTIME_ROLE=strikenova_production_app
# STRIKENOVA_OWNER_ROLE=
# Empty STRIKENOVA_OWNER_ROLE means Topology A (the migrator owns what Alembic
# creates). Set it to the separate NOLOGIN owner role only for Topology B,
# where DDL runs inside an explicit SET ROLE window.

# Optional per-run nonce used only to correlate a rehearsal's lease tokens.
# STRIKENOVA_LEASE_NONCE=
