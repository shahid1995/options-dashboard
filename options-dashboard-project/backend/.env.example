# Copy this file to .env for local development, or set these as environment
# variables on Railway. Never commit the real .env file.

# From your Upstox developer app (https://account.upstox.com/developer/apps)
UPSTOX_API_KEY=your-upstox-api-key
UPSTOX_API_SECRET=your-upstox-api-secret

# Must exactly match the redirect URI registered on your Upstox app,
# e.g. https://<your-backend>.up.railway.app/auth/callback
UPSTOX_REDIRECT_URI=http://localhost:8000/auth/callback

# Where the Next.js frontend is served from (used for redirects and CORS),
# e.g. https://<your-frontend>.vercel.app
FRONTEND_URL=http://localhost:3000

# Optional shared production/staging database.
# Railway PostgreSQL exposes a DATABASE_URL variable reference.
# The backend normalizes postgres:// and postgresql:// to psycopg 3.
# DATABASE_URL=postgresql+psycopg://strikenova_production_app:PASSWORD@HOST:PORT/DBNAME

# Provider-neutral environment selector. Set STRIKENOVA_ENV=production on
# any production host (Render, Railway, a VM, ...). In production mode the
# backend REQUIRES DATABASE_URL pointing at PostgreSQL — the accepted
# strategic production database is Neon PostgreSQL (ADR-019); CockroachDB is
# retired — and refuses to start otherwise (no silent SQLite fallback).
# Leave unset for
# local development/tests (intentional SQLite behavior).
# STRIKENOVA_ENV=production

# --- ADR-017/018 migration lease (PostgreSQL only) ---------------------------
# On PostgreSQL startup and every migration run REQUIRE a dedicated migration
# identity, distinct from the serving identity in DATABASE_URL. Both are
# enforced fail-closed; equal or missing identities abort startup.
# STRIKENOVA_MIGRATION_DATABASE_URL=postgresql+psycopg://strikenova_prod_migrator:PASSWORD@HOST:PORT/DBNAME
#
# Role names used by the operator CLI and by catalog verification.
# STRIKENOVA_MIGRATOR_ROLE=strikenova_prod_migrator
# STRIKENOVA_RUNTIME_ROLE=strikenova_production_app
#
# Topology switch (ADR-017/018 §8.3). Leave STRIKENOVA_OWNER_ROLE EMPTY for
# Topology A: no separate owner role exists and the migration identity owns the
# objects it creates; schema-scoped default privileges are bound to the
# migrator. Set it (e.g. strikenova_prod_owner) for Topology B, where a NOLOGIN
# owner role owns application objects and the migrator reaches it only through
# an explicit SET ROLE window during Alembic DDL; the default privileges are
# then bound to that owner. In both cases they are scoped to schema "public"
# and grant the runtime role DML plus sequence USAGE only.
# STRIKENOVA_OWNER_ROLE=
#
# Lease timing. The TTL bounds recovery of an abandoned lease row; the wait
# budget and lock timeout bound admission. Defaults are measured, not guessed
# (see docs/ADR-017-018-IMPLEMENTATION-RUNBOOK.md §7).
# MIGRATION_BACKFILL_STATEMENT_TIMEOUT_MS must be STRICTLY BELOW
# MIGRATION_LEASE_TTL_SECONDS * 1000; equality or a larger value is refused at
# configuration validation (defaults: 150000 < 300000).
# MIGRATION_LEASE_TTL_SECONDS=300
# MIGRATION_LEASE_WAIT_SECONDS=180
# MIGRATION_LEASE_LOCK_TIMEOUT_MS=10000
# MIGRATION_BACKFILL_STATEMENT_TIMEOUT_MS=150000
# STRIKENOVA_LEASE_NONCE=operator-supplied-unique-guard-nonce-never-published
