# Copy this file to .env for local development, or set these as environment
# variables on Railway. Never commit the real .env file.

# From your Upstox developer app (https://account.upstox.com/developer/apps)
UPSTOX_API_KEY=your-upstox-api-key
UPSTOX_API_SECRET=your-upstox-api-secret

# Must exactly match the redirect URI registered on your Upstox app,
# e.g. https://<your-backend>.up.railway.app/auth/callback
UPSTOX_REDIRECT_URI=http://localhost:8000/auth/callback

# Where the Next.js frontend is served from (used for redirects and CORS),
# e.g. https://<your-frontend>.vercel.app
FRONTEND_URL=http://localhost:3000

# Optional shared production/staging database.
# Railway PostgreSQL exposes a DATABASE_URL variable reference.
# The backend normalizes postgres:// and postgresql:// to psycopg 3.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME

# Provider-neutral environment selector. Set STRIKENOVA_ENV=production on
# any production host (Render, Railway, a VM, ...). In production mode the
# backend REQUIRES DATABASE_URL pointing at PostgreSQL/CockroachDB and
# refuses to start otherwise (no silent SQLite fallback). Leave unset for
# local development/tests (intentional SQLite behavior).
# STRIKENOVA_ENV=production
