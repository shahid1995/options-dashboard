+#: connections: ``create_engine()`` is lazy, and every connection is enabled
+#: and verified separately by the connect listener. A refused or failed
+#: attempt leaves no entry.
 _SQLITE_FK_STATE: dict[str, str] = {}
 
+#: Pages copied per Online Backup step. Positive on purpose: the ``sqlite3``
+#: default is ``-1``, which copies the whole database in a single unbounded
+#: step, so the snapshot could not advance incrementally.
+_BACKUP_PAGE_BATCH = 512
+
+#: Seconds a single Backup API step may wait for the source lock. Kept short
+#: because the step loop retries until the configured budget
+#: (``settings.SQLITE_FK_PREFLIGHT_TIMEOUT_SECONDS``); a long per-attempt wait
+#: would let one lock attempt outlast the whole budget.
+_SNAPSHOT_LOCK_WAIT_SECONDS = 0.5
+
+#: Seconds to sleep between Backup API retries while the source is locked.
+#: ``sqlite3`` retries ``SQLITE_BUSY`` internally, so this is a paced retry
+#: interval, not a busy spin.
+_SNAPSHOT_RETRY_SECONDS = 0.05
+
+#: VM instructions between deadline checks while ``PRAGMA foreign_key_check``
+#: scans the snapshot. Small enough to bound how far the scan can overshoot
+#: the budget, large enough that the hook costs nothing measurable.
+_CHECK_PROGRESS_STEPS = 1000
+
+#: Distinct offending table names retained in a violation error's diagnostic
+#: sample. The sample exists for humans; the total count is always exact, so
+#: this limit bounds memory rather than knowledge of how much is broken.
+_VIOLATION_TABLE_SAMPLE_LIMIT = 20
+
+#: URL query options the pysqlite driver consumes itself. They reach
+#: ``sqlite3.connect()`` as keyword arguments and never change which file opens.
+_SQLITE_DRIVER_OPTIONS = frozenset(
+    {
+        "timeout",
+        "isolation_level",
+        "detect_types",
+        "check_same_thread",
+        "cached_statements",
+    }
+)
+
+#: SQLite URI ``mode`` values that still name the same database file. The
+#: inspection always opens ``mode=ro`` itself; the application's value only has
+#: to select the same file.
+_SQLITE_URI_MODES = frozenset({"rw", "rwc", "ro"})
+
+#: URI options whose effect the read-only snapshot cannot reproduce, so a URL
+#: that requests them is refused rather than inspected under other semantics.
+_SQLITE_UNSUPPORTED_URI_OPTIONS = frozenset({"vfs", "immutable", "nolock"})
+
+#: ``os.stat`` by name so tests can inject filesystem failures deterministically
+#: instead of depending on host permissions (or on running as root).
+_stat = os.stat
+
+
+class SQLitePreflightError(RuntimeError):
+    """Base class for failures that must stop SQLite startup."""
+
+
+class SQLiteForeignKeyViolation(SQLitePreflightError):
+    """The database already contains foreign-key violations.
+
+    Enforcing ``foreign_keys=ON`` here would reject writes that previously
+    succeeded, and starting with enforcement off would leave every foreign key
+    inert, so engine creation is refused instead.
+    """
+
+    def __init__(self, path, violations, tables, sample_truncated):
+        self.path = path
+        #: Exact number of violating rows found; never bounded.
+        self.violations = violations
+        #: At most ``_VIOLATION_TABLE_SAMPLE_LIMIT`` distinct table names.
+        self.tables = tables
+        #: True when more distinct tables exist than ``tables`` retains.
+        self.sample_truncated = sample_truncated
+        sample = ", ".join(tables) or "unknown tables"
+        if sample_truncated:
+            sample += f", plus more beyond a {len(tables)}-table sample"
+        super().__init__(
+            f"SQLite database {path} has {violations} foreign-key violation(s) "
+            f"in {sample}. Repair these rows, then restart: startup is "
+            "refused while enforcement cannot be guaranteed."
+        )
+
+
+class UnsafeSQLiteConfiguration(SQLitePreflightError):
+    """The SQLite target cannot be inspected or enforced safely.
+
+    Raised for unresolvable URLs, named shared-memory databases, malformed
+    files, snapshot failures and failed pragma verification.
+    """
+
+
+class SQLitePreflightTimeout(UnsafeSQLiteConfiguration):
+    """The SQLite foreign-key preflight exceeded its time budget."""
+
 
