+# ---------------------------------------------------------------------------
+# Preflight reads are non-mutating: read-only source + Online Backup snapshot
+# ---------------------------------------------------------------------------
+
+
+def _make_wal_database(path, *, orphan=False, unclean=True):
+    """Create a WAL database, optionally leaving committed frames uncheckpointed.
+
+    With ``unclean=True`` the writer exits without closing its connection, so the
+    ``-wal`` file survives and the rows -- including any orphan -- exist only in
+    WAL frames until something checkpoints the database.
+    """
+    statements = [
+        "import os, sqlite3",
+        f"conn = sqlite3.connect({str(path)!r})",
+        "conn.execute('PRAGMA journal_mode=WAL')",
+        "conn.execute('CREATE TABLE parent(id INTEGER PRIMARY KEY)')",
+        "conn.execute('CREATE TABLE child(id INTEGER PRIMARY KEY, "
+        "pid INTEGER REFERENCES parent(id))')",
+        "conn.execute('INSERT INTO parent VALUES (1)')",
+        "conn.execute('INSERT INTO child VALUES (1, 1)')",
+    ]
+    if orphan:
+        statements.append("conn.execute('INSERT INTO child VALUES (2, 999)')")
+    statements.append("conn.commit()")
+    statements.append("os._exit(0)" if unclean else "conn.close()")
+    subprocess.run([sys.executable, "-c", "\n".join(statements)], check=True)
+    return path
+
+
+def _digest(path):
+    with open(path, "rb") as handle:
+        return hashlib.sha256(handle.read()).hexdigest()
+
+
+def test_preflight_snapshot_leaves_the_database_and_wal_byte_identical(tmp_path):
+    """Inspecting a crashed WAL database neither rewrites it nor loses the WAL."""
+    path = _make_wal_database(tmp_path / "wal_dirty.db", orphan=True, unclean=True)
+    wal = f"{path}-wal"
+    assert os.path.getsize(wal) > 0, "fixture must leave committed frames in the WAL"
+
+    main_before = _digest(path)
+    wal_before = _digest(wal)
+
+    # The orphan only ever reached WAL frames, so seeing it proves the snapshot
+    # includes committed WAL state instead of reading a pre-WAL image.
+    with pytest.raises(db.SQLiteForeignKeyViolation) as excinfo:
+        db._sqlite_fk_preflight(str(path))
+    assert excinfo.value.violations == 1
+    assert excinfo.value.tables == ["child"]
+    assert os.path.exists(wal), "the preflight deleted the WAL file"
+    assert _digest(path) == main_before, "the preflight wrote to the main database"
+    assert _digest(wal) == wal_before, "the preflight wrote to the WAL file"
+
+
+def test_preflight_leaves_a_checkpointed_database_byte_identical(tmp_path):
+    """A cleanly closed WAL database is also inspected without being touched."""
+    path = _make_wal_database(tmp_path / "wal_clean.db", orphan=False, unclean=False)
+    main_before = _digest(path)
+
+    assert db._sqlite_fk_preflight(str(path)) is None
+
+    assert _digest(path) == main_before
+
+
+def test_preflight_creates_no_sidecars_for_a_rollback_journal_database(tmp_path):
+    """Without a WAL, the read-only snapshot leaves no files behind at all."""
+    path = tmp_path / "rollback.db"
+    conn = sqlite3.connect(path)
+    try:
+        conn.execute("CREATE TABLE parent(id INTEGER PRIMARY KEY)")
+        conn.execute(
+            "CREATE TABLE child(id INTEGER PRIMARY KEY, "
+            "pid INTEGER REFERENCES parent(id))"
+        )
+        conn.execute("INSERT INTO parent VALUES (1)")
+        conn.execute("INSERT INTO child VALUES (1, 1)")
+        conn.execute("INSERT INTO child VALUES (2, 999)")
+        conn.commit()
+    finally:
+        conn.close()
+
+    with pytest.raises(db.SQLiteForeignKeyViolation):
+        db._sqlite_fk_preflight(str(path))
+    assert [p.name for p in tmp_path.iterdir()] == ["rollback.db"]
+
+
+def test_preflight_removes_its_temporary_snapshot(tmp_path):
+    """The private copy is cleaned up, so repeated preflights do not accumulate files."""
+    path = _make_wal_database(tmp_path / "wal_cleanup.db", orphan=False)
+    before = _snapshot_directories()
+
+    db._sqlite_fk_preflight(str(path))
+
+    assert _snapshot_directories() - before == set()
+
+
+def test_preflight_inspects_a_file_uri_instead_of_skipping_it(tmp_path):
+    """A ``file:`` target names a real database and must be checked like one."""
+    path = _make_wal_database(tmp_path / "uri_dirty.db", orphan=True)
+
+    with pytest.raises(db.SQLiteForeignKeyViolation) as excinfo:
+        db._sqlite_fk_preflight(f"file:{path}", {"uri": "true"})
+
+    assert (excinfo.value.violations, excinfo.value.tables) == (1, ["child"])
+
+
+def test_preflight_resolves_a_percent_encoded_uri_path(tmp_path):
+    """Percent-encoded URI paths resolve to the file SQLite would open."""
+    directory = tmp_path / "dir with space"
+    directory.mkdir()
+    path = _make_wal_database(directory / "fk.db", orphan=True)
+
+    with pytest.raises(db.SQLiteForeignKeyViolation) as excinfo:
+        db._sqlite_fk_preflight(f"file:{quote(str(path))}", {"uri": "true"})
+
+    assert excinfo.value.violations == 1
+
+
+def test_preflight_rejects_a_mode_memory_uri():
+    """A named in-memory database cannot be inspected, so it is not assumed clean."""
+    with pytest.raises(db.UnsafeSQLiteConfiguration, match="named in-memory"):
+        db._sqlite_fk_preflight(
+            "file:memdb1", {"uri": "true", "mode": "memory", "cache": "shared"}
+        )
+
+
+def _snapshot_directories():
+    return {n for n in os.listdir(tempfile.gettempdir()) if n.startswith("fk-preflight-")}
+
+
+def _large_database(path, *, orphan=False):
+    """A database big enough that the Online Backup API needs several batches."""
+    conn = sqlite3.connect(path)
+    try:
+        conn.execute("CREATE TABLE parent(id INTEGER PRIMARY KEY)")
+        conn.execute(
+            "CREATE TABLE child(id INTEGER PRIMARY KEY, "
